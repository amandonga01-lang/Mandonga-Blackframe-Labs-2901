# Copy to .env.local for local dev; set the same names in Vercel > Settings > Environment Variables.

# Adobe Fonts web project with Neue Haas Grotesk Display Pro + Text Pro (the 7-character kit ID)
NEXT_PUBLIC_ADOBE_FONTS_KIT=

# Booking link: Cal.com handle like "blackframelabs/intro", or a full Cal.com / Calendly URL
NEXT_PUBLIC_CAL_LINK=

# Contact form (Resend). The FROM address must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@blackframelab.com
CONTACT_FROM_EMAIL=website@blackframelab.com

# Canonical site URL (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://www.blackframelabs.com

# Optional: Plausible domain. Vercel Analytics works without any variable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
